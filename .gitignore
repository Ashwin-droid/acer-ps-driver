# Downloaded tools, vendor packages, and release/build artifacts.
/tools/
/extracted/
/*.zip
/*.tar.gz
/target/
/dist/

# Keep authored research notes and the two build-required HID descriptors.
/research/*
!/research/*.md
!/research/firmware/
/research/firmware/*
!/research/firmware/acer-ec-hid-descriptor.bin
!/research/firmware/enek5130-descriptor.bin
!/research/parallel-native/
/research/parallel-native/*
!/research/parallel-native/*.md
!/research/windows-installed/
/research/windows-installed/*
!/research/windows-installed/NOTES.md

# Kernel build output; retain Rust bindings and the public verification key.
/kernel/*.o
/kernel/*.ko
/kernel/*.mod
/kernel/*.mod.c
/kernel/.*.cmd
/kernel/.*.d
/kernel/Module.symvers
/kernel/modules.order
/kernel/.tmp_versions/

# Private signing material and local credentials never belong in the repo.
*.pem
*.key
*.priv
*.p12
*.pfx
dev-signing/
.env
.env.*
!.env.example
!.env.sample

__pycache__/
*.py[cod]
.DS_Store
